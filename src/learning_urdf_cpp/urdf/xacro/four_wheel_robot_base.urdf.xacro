<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:property name="PI" value="3.1415927"/>
    <xacro:property name="base_length" value="0.20"/>
    <xacro:property name="base_width" value="0.12"/>
    <xacro:property name="base_height" value="0.07"/>
    <xacro:property name="ground_clearance" value="0.015"/>
    <xacro:property name="wheel_radius" value="0.025"/>
    <xacro:property name="wheel_width" value="0.02"/>

    <material name="chassis_blue">
        <color rgba="0.1 0.4 0.8 1.0"/>
    </material>

    <material name="wheel_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
    </material>

    <material name="sensor_red">
        <color rgba="0.8 0.1 0.1 1.0"/>
    </material>

    <material name="lidar_blue">
        <color rgba="0.0 0.2 0.5 1.0"/>
    </material>

    <link name="base_footprint">
        <visual>
            <geometry>
                <sphere radius="0.001"/>
            </geometry>
            <material name="wheel_black"/>
        </visual>
    </link>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <material name="chassis_blue"/>
        </visual>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 ${ground_clearance + base_height / 2}" rpy="0.0 0.0 0.0"/>
    </joint>

    <xacro:macro name="wheel" params="wheel_name x_sign y_sign">
        <link name="${wheel_name}_wheel_link">
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="${PI / 2} 0.0 0.0"/>
                <material name="wheel_black"/>
            </visual>
        </link>

        <joint name="${wheel_name}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_name}_wheel_link"/>
            <origin
                xyz="${(base_length / 2 - wheel_radius) * x_sign} ${(base_width / 2 + wheel_width / 2) * y_sign} ${wheel_radius - ground_clearance - base_height / 2}"
                rpy="0.0 0.0 0.0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
    </xacro:macro>

    <xacro:wheel wheel_name="front_left" x_sign="1" y_sign="1"/>
    <xacro:wheel wheel_name="front_right" x_sign="1" y_sign="-1"/>
    <xacro:wheel wheel_name="rear_left" x_sign="-1" y_sign="1"/>
    <xacro:wheel wheel_name="rear_right" x_sign="-1" y_sign="-1"/>
</robot>
