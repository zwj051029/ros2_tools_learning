<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
    <xacro:property name="camera_length" value="0.012"/>
    <xacro:property name="camera_width" value="0.05"/>
    <xacro:property name="camera_height" value="0.01"/>
    <xacro:property name="camera_x" value="${base_length / 2 - camera_length / 2}"/>
    <xacro:property name="camera_z" value="${base_height / 2 + camera_height / 2}"/>

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}"/>
            </geometry>
            <material name="sensor_red"/>
        </visual>
    </link>

    <joint name="camera_joint" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="${camera_x} 0.0 ${camera_z}" rpy="0.0 0.0 0.0"/>
    </joint>
</robot>
